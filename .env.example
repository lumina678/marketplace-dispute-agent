# 本地 Python 默认配置；容器/staging/production 请使用 deploy/env/*.env.example。
XIANYU_ENVIRONMENT=development
XIANYU_RELEASE=local
XIANYU_PUBLIC_BASE_URL=http://127.0.0.1:8000
XIANYU_DATABASE_URL=sqlite:///data/dispute_agent.db
# 可选：覆盖版本化确定性 Router 配置路径。
# XIANYU_ROUTER_CONFIG_PATH=config/dispute_router.json
XIANYU_MAX_QUESTION_ROUNDS=3
XIANYU_DEFAULT_TOOL_CALL_BUDGET=60
XIANYU_DEFAULT_TOKEN_BUDGET=40000
XIANYU_MAX_PHASE_FAILURES=2

# 异步 Workflow：FastAPI 只入队，RQ Worker 执行 Agent/模型调用。
XIANYU_WORKFLOW_QUEUE_BACKEND=rq
XIANYU_REDIS_URL=redis://127.0.0.1:6379/0
XIANYU_WORKFLOW_QUEUE_NAME=xianyu-workflow
XIANYU_WORKFLOW_JOB_TIMEOUT_SECONDS=600
XIANYU_WORKFLOW_MAX_ATTEMPTS=3
XIANYU_WORKFLOW_RETRY_DELAYS_SECONDS=5,30
XIANYU_WORKFLOW_HEARTBEAT_INTERVAL_SECONDS=5
XIANYU_WORKFLOW_STALE_AFTER_SECONDS=30
# XIANYU_WORKFLOW_SSE_POLL_INTERVAL_SECONDS=0.5

# 自有模型：填写 BASE_URL 和 NAME 后会自动从规则基线切换为 OpenAI-compatible 后端。
# BASE_URL 应指向兼容 API 根路径（通常以 /v1 结尾），系统会调用 /chat/completions 和 /models。
XIANYU_MODEL_BASE_URL=http://127.0.0.1:11434/v1
XIANYU_MODEL_API_KEY=
XIANYU_MODEL_NAME=qwen3

# 可选调优项
# XIANYU_MODEL_TIMEOUT_SECONDS=120
# XIANYU_MODEL_HEALTH_TIMEOUT_SECONDS=5
# XIANYU_MODEL_RESPONSE_FORMAT=auto
# XIANYU_MODEL_MAX_RETRIES=2
# XIANYU_MODEL_RETRY_BACKOFF_SECONDS=0.5
# XIANYU_MODEL_SCHEMA_REPAIR_ATTEMPTS=1
