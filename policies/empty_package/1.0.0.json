{
  "schema_version": "1.0.0",
  "policy_id": "marketplace.empty_package",
  "version": "1.0.0",
  "title": "二手交易空包争议处理规则（演示版）",
  "platform": "demo-marketplace",
  "status": "ACTIVE",
  "effective_from": "2025-01-01T00:00:00+08:00",
  "effective_to": null,
  "selection_basis": {"transaction_time_field": "paid_at", "interval_semantics": "[effective_from,effective_to)", "timezone": "Asia/Shanghai"},
  "scope": {"dispute_types": ["EMPTY_PACKAGE"], "listing_categories": ["USED_LAPTOP"]},
  "authority": {
    "automatic_final_decision_allowed": false,
    "human_review_required": true,
    "auto_suggestion_refund_limit": {"currency": "CNY", "amount_minor": 200000},
    "allowed_outcomes": ["RETURN_AND_FULL_REFUND", "PARTIAL_REFUND", "REJECT_CLAIM", "REQUEST_MORE_EVIDENCE", "RELEASE_FUNDS", "ESCALATE_TO_HUMAN"],
    "mandatory_human_review_triggers": [
      {"code": "WEIGHT_CHAIN_CONFLICT", "description": "揽收、运输和签收重量链冲突。"},
      {"code": "PACKING_OR_OPENING_RECORD_CONTESTED", "description": "打包或首次开包记录存在重大争议。"},
      {"code": "FRAUD_ALLEGATION", "description": "案件包含欺诈或伪造证据指控。"},
      {"code": "POLICY_SELECTION_ERROR", "description": "无法唯一选定支付时点有效政策。"}
    ]
  },
  "evidence_requirements": [
    {"requirement_id": "ER-EP-WEIGHT-CHAIN", "applies_to_claim_types": ["PACKAGE_EMPTY", "CONTENT_NOT_RECEIVED", "WEIGHT_ANOMALY"], "description": "揽收、运输或签收重量及运单异常形成连续链。", "accepted_evidence_types": ["SHIPMENT_EVENT", "DOCUMENT"], "minimum_independent_sources": 1, "mandatory_for_finding": true},
    {"requirement_id": "ER-EP-PACKING-OPENING", "applies_to_claim_types": ["PACKAGE_EMPTY", "CONTENT_NOT_RECEIVED"], "description": "打包与首次开包记录能够关联涉案运单并说明形成时间。", "accepted_evidence_types": ["DOCUMENT", "PARTY_STATEMENT", "PHOTO", "VIDEO"], "minimum_independent_sources": 1, "mandatory_for_finding": true},
    {"requirement_id": "ER-EP-WAYBILL", "applies_to_claim_types": ["PACKAGE_EMPTY", "CONTENT_NOT_RECEIVED", "WEIGHT_ANOMALY"], "description": "材料能够关联唯一运单或交易包裹。", "accepted_evidence_types": ["SHIPMENT_EVENT", "DOCUMENT"], "minimum_independent_sources": 1, "mandatory_for_finding": true}
  ],
  "rules": [
    {"rule_id": "EP-DEF-01", "title": "空包的构成", "category": "DEFINITION", "text": "包裹已被交付但交易商品未进入或未随包裹交付，且运单、重量和开包材料能够关联同一包裹时，可构成空包。", "conditions": ["存在唯一运单关联", "存在包裹内容缺失事实"], "required_evidence_refs": ["ER-EP-WEIGHT-CHAIN", "ER-EP-PACKING-OPENING", "ER-EP-WAYBILL"], "allowed_outcomes": ["RETURN_AND_FULL_REFUND", "REQUEST_MORE_EVIDENCE", "REJECT_CLAIM"], "priority": 100, "guard_checks": ["FACTS_HAVE_EVIDENCE", "ALL_MATERIAL_CLAIMS_ADDRESSED"]},
    {"rule_id": "EP-BURDEN-01", "title": "空包举证责任", "category": "BURDEN", "text": "主张空包的一方应先提交重量链和首次开包材料；仅凭买方单方陈述不得直接全额退款。", "conditions": ["买方主张包裹为空"], "required_evidence_refs": ["ER-EP-WEIGHT-CHAIN", "ER-EP-PACKING-OPENING"], "allowed_outcomes": ["REQUEST_MORE_EVIDENCE", "REJECT_CLAIM", "ESCALATE_TO_HUMAN"], "priority": 95, "guard_checks": ["WEIGHT_CHAIN_CHECKED"]},
    {"rule_id": "EP-EVIDENCE-01", "title": "重量链与开包记录冲突", "category": "EVIDENCE", "text": "重量节点冲突、打包或首次开包记录互相矛盾时必须人工核验，不得将单方说法写成既定事实。", "conditions": ["重量或内容记录冲突"], "required_evidence_refs": ["ER-EP-WEIGHT-CHAIN", "ER-EP-PACKING-OPENING"], "allowed_outcomes": ["REQUEST_MORE_EVIDENCE", "ESCALATE_TO_HUMAN"], "priority": 115, "guard_checks": ["WEIGHT_CHAIN_CONFLICT_ESCALATED", "NO_UNSUPPORTED_EMPTY_PACKAGE_FINDING"]},
    {"rule_id": "EP-REMEDY-01", "title": "空包处置", "category": "REMEDY", "text": "重量链、运单关联和打包/开包记录一致支持空包时可建议全额退款；通常无需把承运责任直接转化为卖方责任。", "conditions": ["空包事实得到多源支持"], "required_evidence_refs": ["ER-EP-WEIGHT-CHAIN", "ER-EP-PACKING-OPENING", "ER-EP-WAYBILL"], "allowed_outcomes": ["RETURN_AND_FULL_REFUND", "ESCALATE_TO_HUMAN"], "priority": 85, "guard_checks": ["REFUND_NOT_OVERPAID_AMOUNT"]},
    {"rule_id": "EP-INSUFFICIENT-01", "title": "空包证据不足", "category": "INSUFFICIENT_EVIDENCE", "text": "缺少重量链、运单或首次开包材料时应定向补问，补问后仍不足才可驳回或转人工。", "conditions": ["关键链条事实缺失"], "required_evidence_refs": [], "allowed_outcomes": ["REQUEST_MORE_EVIDENCE", "REJECT_CLAIM", "ESCALATE_TO_HUMAN"], "priority": 105, "guard_checks": ["NO_UNSUPPORTED_ESTABLISHED_FACT", "QUESTION_IS_TARGETED"]},
    {"rule_id": "EP-ESCALATE-01", "title": "空包强制人工", "category": "ESCALATION", "text": "重量链冲突、打包/开包记录争议或欺诈指控必须人工审核；MVP 所有建议均需人工批准。", "conditions": ["命中强制人工条件"], "required_evidence_refs": [], "allowed_outcomes": ["ESCALATE_TO_HUMAN"], "priority": 120, "guard_checks": ["MANDATORY_HUMAN_REVIEW_ENFORCED"]}
  ],
  "source": {"kind": "SYNTHETIC_DEMO_POLICY", "notice": "本规则仅用于软件演示和测试，不代表任何现实平台规则，也不构成法律意见。"}
}
