{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://demo-marketplace.local/schemas/policy-version.schema.json",
  "title": "Versioned Marketplace Dispute Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "title",
    "platform",
    "status",
    "effective_from",
    "effective_to",
    "selection_basis",
    "scope",
    "authority",
    "evidence_requirements",
    "rules",
    "source"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "policy_id": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "const": "demo-marketplace" },
    "status": { "enum": ["ACTIVE", "RETIRED", "DRAFT"] },
    "effective_from": { "type": "string", "format": "date-time" },
    "effective_to": {
      "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }]
    },
    "selection_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transaction_time_field", "interval_semantics", "timezone"],
      "properties": {
        "transaction_time_field": { "type": "string", "const": "paid_at" },
        "interval_semantics": { "type": "string", "const": "[effective_from,effective_to)" },
        "timezone": { "type": "string", "const": "Asia/Shanghai" }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dispute_types", "listing_categories"],
      "properties": {
        "dispute_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "DESCRIPTION_MISMATCH",
              "MISSING_PARTS",
              "EMPTY_PACKAGE",
              "SHIPPING_DAMAGE",
              "COUNTERFEIT",
              "OTHER"
            ]
          }
        },
        "listing_categories": {
          "type": "array",
          "contains": { "const": "USED_LAPTOP" },
          "minContains": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automatic_final_decision_allowed",
        "human_review_required",
        "auto_suggestion_refund_limit",
        "allowed_outcomes",
        "mandatory_human_review_triggers"
      ],
      "properties": {
        "automatic_final_decision_allowed": { "type": "boolean", "const": false },
        "human_review_required": { "type": "boolean", "const": true },
        "auto_suggestion_refund_limit": { "$ref": "case-file.schema.json#/$defs/Money" },
        "allowed_outcomes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "RETURN_AND_FULL_REFUND",
              "PARTIAL_REFUND",
              "REJECT_CLAIM",
              "REQUEST_MORE_EVIDENCE",
              "RELEASE_FUNDS",
              "ESCALATE_TO_HUMAN"
            ]
          }
        },
        "mandatory_human_review_triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "description"],
            "properties": {
              "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "evidence_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement_id",
          "applies_to_claim_types",
          "description",
          "accepted_evidence_types",
          "minimum_independent_sources",
          "mandatory_for_finding"
        ],
        "properties": {
          "requirement_id": { "type": "string", "pattern": "^ER-[A-Z0-9-]+$" },
          "applies_to_claim_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
          },
          "description": { "type": "string", "minLength": 1 },
          "accepted_evidence_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
          },
          "minimum_independent_sources": { "type": "integer", "minimum": 1 },
          "mandatory_for_finding": { "type": "boolean" }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "title",
          "category",
          "text",
          "conditions",
          "required_evidence_refs",
          "allowed_outcomes",
          "priority",
          "guard_checks"
        ],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_.-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "category": {
            "enum": ["DEFINITION", "FILING", "BURDEN", "EVIDENCE", "REMEDY", "SHIPPING", "INSUFFICIENT_EVIDENCE", "ESCALATION", "APPEAL"]
          },
          "text": { "type": "string", "minLength": 1 },
          "conditions": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "required_evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^ER-[A-Z0-9-]+$" }
          },
          "allowed_outcomes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
          },
          "priority": { "type": "integer", "minimum": 1, "maximum": 1000 },
          "guard_checks": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "notice"],
      "properties": {
        "kind": { "type": "string", "const": "SYNTHETIC_DEMO_POLICY" },
        "notice": { "type": "string", "minLength": 1 }
      }
    }
  }
}
