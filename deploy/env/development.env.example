COMPOSE_PROJECT_NAME=xianyu-dev
XIANYU_ENVIRONMENT=development
XIANYU_RELEASE=local
XIANYU_DOMAIN=localhost
XIANYU_PUBLIC_BASE_URL=http://127.0.0.1:18000
XIANYU_HTTP_PORT=18080
XIANYU_HTTPS_PORT=18443
XIANYU_API_PORT=18000
XIANYU_POSTGRES_PORT=15432
XIANYU_REDIS_PORT=16379

POSTGRES_DB=xianyu
POSTGRES_USER=xianyu
POSTGRES_PASSWORD=xianyu-local-only
XIANYU_DATABASE_URL=postgresql+psycopg://xianyu:xianyu-local-only@postgres:5432/xianyu
XIANYU_REDIS_URL=redis://redis:6379/0
XIANYU_READINESS_REQUIRE_WORKER=false

XIANYU_MODEL_BACKEND=rule_based
XIANYU_MODEL_BASE_URL=
XIANYU_MODEL_API_KEY=
XIANYU_MODEL_NAME=
