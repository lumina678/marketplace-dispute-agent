COMPOSE_PROJECT_NAME=xianyu-staging
XIANYU_ENVIRONMENT=staging
XIANYU_RELEASE=git-sha-or-v0.2.0-rc1
XIANYU_DOMAIN=staging.example.com
XIANYU_PUBLIC_BASE_URL=https://staging.example.com
XIANYU_HTTP_PORT=80
XIANYU_HTTPS_PORT=443

POSTGRES_DB=xianyu_staging
POSTGRES_USER=xianyu_staging
POSTGRES_PASSWORD=replace-with-secret-store-value
XIANYU_DATABASE_URL=postgresql+psycopg://xianyu_staging:replace-with-url-encoded-password@postgres:5432/xianyu_staging
XIANYU_DATABASE_POOL_SIZE=5
XIANYU_DATABASE_MAX_OVERFLOW=10
XIANYU_REDIS_URL=redis://redis:6379/0
XIANYU_READINESS_REQUIRE_WORKER=true

XIANYU_MODEL_BACKEND=openai_compatible
XIANYU_MODEL_BASE_URL=https://your-model-gateway.example.com/v1
XIANYU_MODEL_API_KEY=replace-with-secret-store-value
XIANYU_MODEL_NAME=your-model-name
