{$XIANYU_DOMAIN:localhost} {
	encode zstd gzip

	reverse_proxy api:8000 {
		flush_interval -1
		health_uri /health
		health_interval 15s
		health_timeout 3s
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	log {
		output stdout
		format json
	}
}
